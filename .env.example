﻿PORT=5000
HOST=0.0.0.0
# Production: use only exact HTTPS origins; localhost defaults are development-only.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000
TRUST_PROXY=false
SWAGGER_ENABLED=true
MONGODB_URI=
# Used only by `npm run provision:admin`; replace before provisioning a real admin.
# This is an account email, not a password or runtime secret.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# Required by any migration/bootstrap apply command after taking a backup.
MIGRATION_BACKUP_REFERENCE=
# Production requires a unique secret with at least 32 characters.
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

STORAGE_DRIVER=cloudinary
UPLOAD_DIR=uploads
MAX_CV_FILE_SIZE_MB=5
MAX_IMAGE_FILE_SIZE_MB=5
MAX_PORTFOLIO_FILE_SIZE_MB=5
MAX_PORTFOLIO_MEDIA_COUNT=5
PUBLIC_PORTFOLIO_BASE_URL=http://localhost:5173/p
# Legacy Portfolio routes remain readable for compatibility. Their writes are disabled
# automatically in production; set true only for a time-bound compatibility rollback.
ENABLE_LEGACY_PORTFOLIO_WRITES=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_MS=60000
# Fail closed unless the external AI capability is explicitly enabled.
AI_SERVICE_ENABLED=false
# Shared only with the FastAPI service through each platform's secret store.
# Use a unique random value of at least 32 characters in production.
AI_INTERNAL_API_KEY=
# Non-production local/test only. Production startup rejects true.
AI_SERVICE_ALLOW_MOCK_OUTPUT=false
# Reservations are reconciled only after the lease has expired. Keep both values
# above the maximum synchronous AI workflow duration.
AI_USAGE_RESERVATION_TTL_MS=600000
AI_USAGE_RECONCILE_INTERVAL_MS=60000
AI_DEFAULT_INDUSTRY_SLUG=language
AI_DEFAULT_VERTICAL_SLUG=
AI_DEFAULT_COMPANY_MODEL=corporate
AI_DEFAULT_LANGUAGE=both
AI_SUPPORTED_INDUSTRY_SLUGS=ai_software,business_administration,computer_science,language,law,marketing

# Billing stays disabled until the commercial plan, PayOS account, webhook URL, and
# production runbook are approved. Values are configured only in the platform secret store.
BILLING_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
BILLING_RETURN_URL=http://localhost:5173/billing/return
BILLING_CANCEL_URL=http://localhost:5173/billing/cancel
PAYOS_WEBHOOK_URL=
