{
  "name": "cvbuddy-backend",
  "version": "1.0.0",
  "description": "CVBuddy MVP backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "test": "node --test --require ts-node/register/transpile-only tests/portfolio.validation.test.js tests/portfolio-singleton.test.js tests/portfolio-children-singleton.test.js tests/legacy-portfolio-write-guard.test.js tests/security-baseline.test.js tests/database-bootstrap.test.js tests/runtime-contract.test.js tests/observability.test.js tests/ai-service.integration.test.js tests/ai-service.analyze.test.js tests/cv-file-source.adapter.test.js tests/applicant-features.test.js tests/admin-metrics.test.js tests/cv-upload-contract.test.js tests/portfolio-upload-contract.test.js",
    "migrate:single-portfolio": "ts-node scripts/migrate-single-portfolio.ts",
    "migrate:single-portfolio:apply": "ts-node scripts/migrate-single-portfolio.ts --apply",
    "preflight:legacy-portfolio": "ts-node scripts/preflight-legacy-portfolio.ts",
    "bootstrap:database": "ts-node scripts/bootstrap-database.ts",
    "bootstrap:database:apply": "ts-node scripts/bootstrap-database.ts --apply",
    "provision:admin": "ts-node scripts/provision-admin.ts",
    "start": "node dist/server.js",
    "test:ai:e2e": "node --require ts-node/register/transpile-only scripts/test-ai-e2e.ts"
  },
  "keywords": [
    "cvbuddy",
    "backend",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "multer": "^2.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.9"
  }
}
